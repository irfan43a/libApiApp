# Application
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=supersecretjwtkey_perpustakaan_2026
JWT_EXPIRES_IN=7d

# Library Rules
FINE_PER_DAY=1000
LOAN_DURATION_DAYS=7
MAX_BORROW_LIMIT=3

# Database Configuration
# Dialect options: 'sqlite' | 'mysql' | 'postgres'
DB_DIALECT=sqlite
DB_STORAGE=./src/database/library.sqlite

# Settings if using MySQL or PostgreSQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=library_db
DB_USER=root
DB_PASSWORD=
